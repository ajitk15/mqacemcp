# =============================================================================
# Log-insights dashboard — environment variables
#
# Standalone HTTP server that renders the MQ+ACE query-log dashboard.
#
# Self-contained: dashboard_server.py loads THIS file (dashboard/.env) at
# startup via python-dotenv. It does NOT import the MCP server's `server`
# package — every value below is read by the dashboard itself. Process-env
# values take precedence over this file (so a launcher can still inject
# overrides).
#
# Copy to `.env` and adjust as needed. Do NOT commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Dashboard bind settings
# -----------------------------------------------------------------------------
# Bind address and port for the standalone dashboard HTTP server.
# Defaults if unset: host=0.0.0.0, port=8002. Endpoints: /dashboard, /healthz.
# Use 8004 to avoid colliding with the chat backend (8002) and Streamlit (8003).
MCP_DASHBOARD_HOST=0.0.0.0
MCP_DASHBOARD_PORT=8004

# -----------------------------------------------------------------------------
# Color theme
# -----------------------------------------------------------------------------
# Default dashboard color palette: "purple" or "green". Override per-request
# with a ?theme=purple|green query on the /dashboard URL (the tab wrapper
# propagates it to each tab). Unknown values fall back to purple.
DASHBOARD_THEME=purple

# -----------------------------------------------------------------------------
# Log directory
# -----------------------------------------------------------------------------
# Directory containing the query logs to visualise (the fallback single tab).
# Point it at the MCP server's LOG_DIR so the dashboard reads the data that
# server writes. Relative paths resolve under the dashboard/ folder.
# (When MCP_DASHBOARD_SERVERS_JSON is set, each tab supplies its own log_dir and
# this value is only the fallback.)
LOG_DIR=../logs

# -----------------------------------------------------------------------------
# Optional TLS for the dashboard endpoint
# -----------------------------------------------------------------------------
# BOTH cert and key must be set to serve HTTPS; otherwise the dashboard serves
# plain HTTP. Relative paths resolve under the dashboard/ folder.
MCP_TLS_CERT=../certs/cert.pem
MCP_TLS_KEY=../certs/key.pem

# =============================================================================
# Streamlit chat frontend — environment variables
#
# Copy to `.env` and adjust as needed. Do NOT commit `.env`.
# =============================================================================

# URL where the chatbot FastAPI backend is reachable.
# The Streamlit app calls /api/health, /api/chat/stream, and /api/chat/reset
# on this base URL.
MCP_BACKEND_URL=http://localhost:8002

# Optional: override the browser tab title (defaults to backend's header_title).
# PAGE_TITLE=

# Optional: override the page icon (any single emoji or unicode glyph).
# PAGE_ICON=

# Optional: default visibility of the 🔧 tool-call panels in each answer.
# Users can still toggle this at runtime in the sidebar. Default: true.
# SHOW_TOOL_CALLS=true

# Optional: default UI color theme — "purple" or "green". Users can switch it
# live from the sidebar (Display → Theme). Unknown values fall back to purple.
# APP_THEME=purple
